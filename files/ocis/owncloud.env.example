# Секреты, которые передаются через переменные окружения. НЕ коммитить (есть в .gitignore).
# Ключи кластера (JWT, machine auth, system user, transfer, service account, WOPI) лежат в conf/ocis.yaml.

# WOPI: общий секрет для collaboration. В ocis.yaml он записан под старым ключом (wopiapp),
COLLABORATION_WOPI_SECRET=pass
# LDAP: пароль учётной записи CN=ocloud,OU=hm,DC=example,DC=org
OCIS_LDAP_BIND_PASSWORD=pass

# Почта: пароль для tech@exaple.org
NOTIFICATIONS_SMTP_PASSWORD=pass

# Админ-консоль Collabora (подставляется в docker-compose через --env-file)
# Смените и закройте на прокси /browser/dist/admin и /cool/adminws
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=pass
