# Сгенерировано Ansible из files/ocis/conf/csp.yaml.j2. Адреса — из vars/ocis.yml.
directives:
  child-src:
    - '''self'''
    - 'blob:'
  connect-src:
    - '''self'''
    - 'data:'
    - 'blob:'
    - 'https://{{ companion_domain }}/'
    - 'wss://{{ companion_domain }}/'
    - '{{ oidc_issuer | urlsplit("scheme") }}://{{ oidc_issuer | urlsplit("hostname") }}/'
    - 'https://raw.githubusercontent.com/owncloud/awesome-ocis/'
    - 'https://unpkg.com/detect-gpu@5.0.38/dist/benchmarks/d-intel.json'
  default-src:
    - '''none'''
  font-src:
    - '''self'''
    - 'https://unpkg.com/'
    - 'data:'
  frame-ancestors:
    - '''self'''
  frame-src:
    - '''self'''
    - 'blob:'
{% if drawio_url %}
    - '{{ drawio_url }}'
{% endif %}
    - 'https://{{ collabora_domain }}/'
  img-src:
    - '''self'''
    - 'data:'
    - 'blob:'
    - 'https://raw.githubusercontent.com/owncloud/awesome-ocis/'
    - 'https://{{ collabora_domain }}/'
  manifest-src:
    - '''self'''
  media-src:
    - '''self'''
  object-src:
    - '''self'''
    - 'blob:'
  script-src:
    - '''self'''
    - '''unsafe-inline'''
    - 'https://unpkg.com/'
    - '''unsafe-eval'''
  style-src:
    - '''self'''
    - '''unsafe-inline'''
  style-src-elem:
    - '''self'''
    - '''unsafe-inline'''
    - 'https://unpkg.com/'
